---
import Layout from '../layouts/Layout.astro';
import GameSearch from '../components/GameSearch.astro';
import PageHero from '../components/PageHero.astro';
import Pagination from '../components/Pagination.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers, getGamesPage } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const allGames = await getAllGames(db);
const gamesPage = await getGamesPage(db, 1, 6);
const [categories, publishers] = await Promise.all([
    getAllCategories(db),
    getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-4 shadow-lg" data-testid="game-filters">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end">
        <div class="flex-1">
          <label for="category-filter" class="mb-2 block text-sm font-medium text-slate-200">Category</label>
          <select
            id="category-filter"
            name="category"
            multiple
            size={Math.min(categories.length, 6)}
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="category-filter"
            aria-label="Filter games by category"
          >
            {categories.map((category) => (
              <option value={category.id}>{category.name}</option>
            ))}
          </select>
        </div>

        <div class="flex-1">
          <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Publisher</label>
          <select
            id="publisher-filter"
            name="publisher"
            multiple
            size={Math.min(publishers.length, 6)}
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="publisher-filter"
            aria-label="Filter games by publisher"
          >
            {publishers.map((publisher) => (
              <option value={publisher.id}>{publisher.name}</option>
            ))}
          </select>
        </div>

        <div class="flex gap-3">
          <button
            type="submit"
            class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="apply-filters"
          >
            Apply filters
          </button>
          <a
            href="/"
            class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="clear-filters"
          >
            Clear
          </a>
        </div>
      </div>
    </form>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <GameSearch games={allGames} />
      <Pagination page={gamesPage.page} totalPages={gamesPage.totalPages} />
      <div
        data-testid="empty-state"
        hidden
        class="text-center py-12 bg-slate-800/50 backdrop-blur-sm rounded-xl border border-slate-700"
      >
        <p data-testid="empty-state-text" class="text-slate-300">No games match the selected filters.</p>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector('[data-testid="game-filters"]') as HTMLFormElement | null;
  const categoryFilter = document.querySelector('[data-testid="category-filter"]') as HTMLSelectElement | null;
  const publisherFilter = document.querySelector('[data-testid="publisher-filter"]') as HTMLSelectElement | null;
  const gamesGrid = document.querySelector('[data-testid="games-grid"]') as HTMLDivElement | null;
  const emptyState = document.querySelector('[data-testid="empty-state"]') as HTMLDivElement | null;
  const gameCards = Array.from(document.querySelectorAll('[data-testid="game-card"]')) as HTMLElement[];

  function getUrlValues(key: string): string[] {
    const params = new URLSearchParams(window.location.search);
    return params.getAll(key);
  }

  function updateUrlFromSelection(): void {
    if (!categoryFilter || !publisherFilter) {
      return;
    }

    const params = new URLSearchParams();

    Array.from(categoryFilter.selectedOptions).forEach((option: HTMLOptionElement) => params.append('category', option.value));
    Array.from(publisherFilter.selectedOptions).forEach((option: HTMLOptionElement) => params.append('publisher', option.value));

    const nextUrl = new URL(window.location.href);
    nextUrl.search = params.toString();
    window.history.replaceState({}, '', nextUrl);
  }

  function applyClientFilters(): void {
    if (!categoryFilter || !publisherFilter) {
      return;
    }

    const requestedCategories = getUrlValues('category');
    const requestedPublishers = getUrlValues('publisher');
    const selectedCategories = new Set(Array.from(categoryFilter.selectedOptions).map((option: HTMLOptionElement) => option.value));
    const selectedPublishers = new Set(Array.from(publisherFilter.selectedOptions).map((option: HTMLOptionElement) => option.value));
    const hasExplicitCategoryFilter = requestedCategories.length > 0 && selectedCategories.size === 0;
    const hasExplicitPublisherFilter = requestedPublishers.length > 0 && selectedPublishers.size === 0;

    let visibleCount = 0;

    gameCards.forEach((card: HTMLElement) => {
      const categoryId = card.getAttribute('data-game-category');
      const publisherId = card.getAttribute('data-game-publisher');
      const matchesCategory = hasExplicitCategoryFilter ? false : selectedCategories.size === 0 || selectedCategories.has(categoryId ?? '');
      const matchesPublisher = hasExplicitPublisherFilter ? false : selectedPublishers.size === 0 || selectedPublishers.has(publisherId ?? '');
      const shouldShow = matchesCategory && matchesPublisher;

      card.hidden = !shouldShow;
      const searchCard = card.closest('[data-search-card]') as HTMLElement | null;
      if (searchCard) {
        searchCard.hidden = !shouldShow;
      }
      if (shouldShow) {
        visibleCount += 1;
      }
    });

    if (gamesGrid) {
      gamesGrid.hidden = visibleCount === 0;
    }

    if (emptyState) {
      emptyState.hidden = visibleCount > 0;
    }
  }

  if (form && categoryFilter && publisherFilter && gamesGrid && emptyState) {
    const initialCategories = new Set(getUrlValues('category'));
    const initialPublishers = new Set(getUrlValues('publisher'));

    Array.from(categoryFilter.options).forEach((option: HTMLOptionElement) => {
      option.selected = initialCategories.has(option.value);
    });
    Array.from(publisherFilter.options).forEach((option: HTMLOptionElement) => {
      option.selected = initialPublishers.has(option.value);
    });

    form.addEventListener('submit', (event: SubmitEvent) => {
      event.preventDefault();
      updateUrlFromSelection();
      applyClientFilters();
    });

    categoryFilter.addEventListener('change', () => {
      updateUrlFromSelection();
      applyClientFilters();
    });
    publisherFilter.addEventListener('change', () => {
      updateUrlFromSelection();
      applyClientFilters();
    });

    applyClientFilters();
  }
</script>
