---
import Layout from '../layouts/Layout.astro';
import GameSearch from '../components/GameSearch.astro';
import PageHero from '../components/PageHero.astro';
import Pagination from '../components/Pagination.astro';
import { getDatabase } from '../lib/db';
import { getAllGames, getGamesPage } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const allGames = await getAllGames(db);
const gamesPage = await getGamesPage(db, 1, 6);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <GameSearch games={allGames} />
      <Pagination page={gamesPage.page} totalPages={gamesPage.totalPages} />
    </div>
  </div>
</Layout>
