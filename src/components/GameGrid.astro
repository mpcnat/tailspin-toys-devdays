---
import type { Game } from '../types/game';
import EmptyState from './EmptyState.astro';
import GameCard from './GameCard.astro';

/**
 * Props for the reusable game card grid.
 */
interface Props {
    /** Games to render in title order. */
    games: Game[];
    /** Message shown when the supplied game list is empty. */
    emptyText?: string;
}

const { games, emptyText = 'No games available at the moment.' } = Astro.props;
---

{games.length === 0 ? (
    <EmptyState text={emptyText} />
) : (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
        {games.map((game) => <GameCard game={game} />)}
    </div>
)}
